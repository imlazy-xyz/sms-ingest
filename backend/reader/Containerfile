# Local Podman image for the SMS Ingest admin reader UI.
#
# This is a *separate* app/image from backend/Dockerfile (the ingest service).
# It is local-only in v1 (see reader/README.md) — there is no Cloud Run target
# for this image yet.
#
# Build context MUST be `backend/` (not `backend/reader/`), because the reader
# imports the shared `app.core` / `app.repositories` package that lives at
# `backend/app`:
#
#   podman build -f backend/reader/Containerfile -t sms-ingest-reader:local backend
#
# ASSUMPTION for the integrator (backend/reader/main.py does not exist yet at
# packaging time — see reader/README.md "Entrypoint assumptions"): the reader
# ASGI app object is importable as `reader.main:app`. `reader` is deliberately
# NOT added to `[tool.setuptools].packages` in backend/pyproject.toml -- that
# was tried and reverted (sms-ingest#38): the packages list is shared with
# backend/Dockerfile, which builds the separate Cloud Run ingest image and
# never copies reader/, so declaring it there broke that build's
# `pip install .` the moment this branch merged. Copied in below instead and
# run via PYTHONPATH -- this is the permanent shape, not a placeholder.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    READER_PORT=8081

WORKDIR /app

# Install the shared package (app/core, app/repositories, etc.) and runtime deps
# from the existing pyproject.toml, same as backend/Dockerfile.
# `cli` is copied because pyproject.toml declares packages = ["app", "cli"];
# omitting it makes `pip install .` fail on the missing declared package. It also
# gives the image `sms-ingest-admin migrate` for applying migrations if needed.
COPY pyproject.toml README.md ./
COPY app ./app
COPY cli ./cli
COPY migrations ./migrations
RUN pip install .

# Reader package: not yet declared in pyproject.toml (see header note), so copy
# it directly and rely on PYTHONPATH=/app above to make `reader.main` importable.
COPY reader ./reader

# Run as an unprivileged user, matching backend/Dockerfile.
RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8081

# Bind 0.0.0.0 INSIDE the container — loopback-only exposure is enforced by the
# host port publish (`-p 127.0.0.1:8081:8081` in scripts/reader-up.sh /
# reader-pod.yaml), not by uvicorn's --host. Binding uvicorn itself to 127.0.0.1
# here would make it unreachable through podman's port-forward from the host
# netns. Shell form + exec so SIGTERM reaches uvicorn for graceful shutdown.
#
# --no-access-log: some reader routes (e.g. GET /numbers/{id}/thread) put a
# decrypted counterparty phone number in the query string (sms-ingest#39
# review). This is a MITIGATION, not a fix -- it stops uvicorn's default
# access logger from persisting it, but the value still transits as a URL
# (visible to browser history, any intermediary). Left as a follow-up: switch
# that route to POST or an opaque per-thread id instead of `?counterparty=`.
CMD exec uvicorn reader.main:app --host 0.0.0.0 --port ${READER_PORT} --no-access-log
