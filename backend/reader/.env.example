# Admin reader UI — local environment template.
#
# Copy to `backend/reader/.env` and fill in real values. `.env` is gitignored
# repo-wide; NEVER commit real keyset material, a real DATABASE_URL, or tokens.
#
#   cp .env.example .env
#   ./scripts/reader-up.sh
#
# The reader decrypts SMS fields server-side to render them, so it needs the
# SAME key material as the ingest backend (see ../.env.example) — it is not a
# reduced set. Generate values with `sms-ingest-admin gen-keys`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# scripts/reader-up.sh OVERRIDES this with the in-pod address
# (postgresql://postgres:postgres@127.0.0.1:5432/sms_ingest), because the reader
# and Postgres containers share the pod's network namespace. Set it here only
# when running the reader directly with uvicorn (outside the pod), e.g.
# postgresql://postgres:postgres@localhost:5433/sms_ingest against the pod's
# published DB port.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sms_ingest

# ---------------------------------------------------------------------------
# Key material (required — the reader cannot render without it)
# ---------------------------------------------------------------------------
# Tink AEAD keyset (JSON) used to decrypt sensitive SMS fields for display.
FIELD_ENCRYPTION_KEY=

# Tink HPKE keyset material (JSON). Present for parity with the shared config;
# the reader path uses the field key above for display decryption.
TINK_PRIVATE_KEYSET_JSON=
TINK_PUBLIC_KEYSET_JSON=
SERVER_KEY_ID=

# Pepper applied when hashing device bearer tokens (shared config).
TOKEN_HASH_PEPPER=

# ---------------------------------------------------------------------------
# Reader server
# ---------------------------------------------------------------------------
# Port the reader listens on inside the container; the up script publishes it on
# 127.0.0.1 only. Loopback-only exposure is enforced by that host publish
# mapping, not by this value.
READER_PORT=8081
